# Un solo sitio de SiteGround sirve tres dominios (aparcados): cauce-ia.es (principal), cauce-ia.com y
# ramirosantamaria.com. El enrutado por dominio se hace aquí.
#   cauce-ia.es/            -> digitalizacion.html (portada de Cauce IA)
#   cauce-ia.es/equipo      -> index.html (app React del CV)
#   /aviso-legal, /privacidad -> páginas legales (en cualquier dominio)

DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# Validación de certificados (Let's Encrypt): sin redirecciones
RewriteRule ^\.well-known/ - [L]

# Forzar https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www -> sin www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# cauce-ia.com -> cauce-ia.es (misma ruta)
RewriteCond %{HTTP_HOST} ^cauce-ia\.com$ [NC]
RewriteRule ^ https://cauce-ia.es%{REQUEST_URI} [R=301,L]

# ramirosantamaria.com -> cauce-ia.es
# FASE 2: descomentar SOLO cuando https://cauce-ia.es funcione con SSL. Los recursos estáticos (CV en PDF,
# imágenes, assets) se siguen sirviendo para no romper enlaces antiguos.
# RewriteCond %{HTTP_HOST} ^ramirosantamaria\.com$ [NC]
# RewriteRule ^digitalizacion(\.html)?/?$ https://cauce-ia.es/ [R=301,L]
# RewriteCond %{HTTP_HOST} ^ramirosantamaria\.com$ [NC]
# RewriteRule ^(aviso-legal|privacidad)(\.html)?/?$ https://cauce-ia.es/$1 [R=301,L]
# RewriteCond %{HTTP_HOST} ^ramirosantamaria\.com$ [NC]
# RewriteCond %{REQUEST_URI} !^/(assets|files|images|brand|fonts|css|js)/
# RewriteRule ^ https://cauce-ia.es/equipo [R=301,L]

# cauce-ia.es: URLs antiguas de la portada -> /. Se mira THE_REQUEST (lo que pidió el navegador) para no
# entrar en bucle con la reescritura interna de / a digitalizacion.html.
RewriteCond %{HTTP_HOST} ^cauce-ia\.es$ [NC]
RewriteCond %{THE_REQUEST} \s/+digitalizacion(\.html)?/?[\s?] [NC]
RewriteRule ^ https://cauce-ia.es/ [R=301,L]
RewriteCond %{HTTP_HOST} ^cauce-ia\.es$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ https://cauce-ia.es/equipo [R=301,L]

# cauce-ia.es: la portada es la página de Cauce IA (no index.html)
RewriteCond %{HTTP_HOST} ^cauce-ia\.es$ [NC]
RewriteRule ^$ digitalizacion.html [L]

# /equipo -> app del CV (en cualquier dominio, para que también funcione en ramirosantamaria.com en la fase 1)
RewriteRule ^equipo/?$ index.html [L]

# URLs limpias de las páginas legales
RewriteRule ^(aviso-legal|privacidad)/?$ $1.html [L]

# URL limpia: /digitalizacion -> digitalizacion.html (ramirosantamaria.com en la fase 1)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^digitalizacion/?$ digitalizacion.html [L]
